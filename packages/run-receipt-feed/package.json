{
  "name": "dsh-legion-receipts",
  "version": "1.2.0",
  "description": "Live-session Run Receipt Remote companion for dsh-legion.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "scripts": {
    "build": "pnpm run build:package",
    "build:package": "pnpm run clean:package && pnpm run build:host:package && pnpm run build:client:package",
    "build:host": "pnpm run build:host:package",
    "build:host:package": "tsc -b tsconfig.host-face.json && pnpm run bundle:host",
    "build:client": "pnpm run build:client:package",
    "build:client:package": "tsc -b tsconfig.client.json && pnpm run bundle:client",
    "bundle:host": "tsdown --config tsdown.config.ts",
    "bundle:client": "tsdown --config tsdown.client.config.ts",
    "clean": "pnpm run clean:package",
    "clean:package": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "pnpm run typecheck:package",
    "typecheck:package": "pnpm run clean:package && tsc -b tsconfig.host-face.json && pnpm run bundle:host && tsc -b tsconfig.client.json",
    "test": "pnpm run build:package && pnpm run test:unit:package",
    "test:unit:package": "vitest run --root ../.. --config vitest.config.ts packages/run-receipt-feed/tests --maxWorkers=1",
    "benchmark:receipt-feed": "node ../../scripts/benchmark-receipt-feed.mjs",
    "verify:pack": "pnpm run verify:pack:package",
    "verify:pack:package": "pnpm --config.ignore-scripts=true pack --dry-run",
    "prepare": "pnpm run build:package"
  },
  "dsh": {
    "client": {
      "external": [
        "@deepseek-ai/dsh-api-gateway/client"
      ],
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-alpha.1 <0.2.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-gateway": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-test-runtime": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-typert-generator": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-typert-registry": "0.1.2-alpha.1",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxxb789/dsh-legion.git",
    "directory": "packages/run-receipt-feed"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
