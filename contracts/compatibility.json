  "assessedDshVersions": ["0.1.2-alpha.2", "0.1.2-alpha.4"],
  "hostCapabilities": {
    "ephemeralProfileAndStrategy": "supported",
    "journalContractAndPureReplay": "supported",
    "liveSettingsReconfiguration": "capability-detected-optional",
    "durableMutation": "unavailable-fail-closed",
    "reason": "DSH 0.1.2-alpha.4 still provides no atomic run coordination Host service for durable mutation, and required out-of-repository legion/* events cannot enter its generated persisted-event vocabulary or use the ignorable informational-event escape hatch. Journal activation therefore remains fail-closed. Ephemeral Specialists and Strategies remain supported; full Run Receipt facts use the optional process-local companion feed, append no custom Session event, and keep the bounded tool summary when the companion is absent."
  },
  "previousMinorCompatibility": [
    "config-v2-with-durable-fields-omitted",
    "ephemeral-catalog-compilation",
    "profile-and-strategy-request-contracts",
    "event-free-session-empty-projection"
  ],
